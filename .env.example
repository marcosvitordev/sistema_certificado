# Caminhos opcionais para o banco SQLite local.
# DATA_DIR=/var/lib/certifica-ces/data
# DB_PATH=/var/lib/certifica-ces/data/sistema_cursos.db

# Render / Supabase. Sem DATABASE_URL, o modo local continua usando SQLite.
# BASE_URL deve ser a URL pública da Vercel (usada nos QR Codes).
# REQUIRE_POSTGRES=1
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST_POOLER:5432/postgres?sslmode=verify-full
# Certificado CA do Supabase, quando necessário (PEM com quebras escapadas como \n).
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
